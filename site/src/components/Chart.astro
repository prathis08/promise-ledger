---
// Renders a Chart.js bar chart from a JSON config in a data attribute. Script is bundled by Astro (no CDN).
// The latest period takes the one data hue; earlier periods are drawn in grey.
const { config, label, height } = Astro.props;
---
<div class="chartbox" style={height ? `height:${height}px` : undefined}>
  <canvas data-chart={JSON.stringify(config)} role="img" aria-label={label}></canvas>
</div>
<script>
  import { Chart, BarController, BarElement, CategoryScale, LinearScale, Tooltip } from 'chart.js';
  Chart.register(BarController, BarElement, CategoryScale, LinearScale, Tooltip);
  const css = getComputedStyle(document.documentElement);
  const v = (n: string) => css.getPropertyValue(n).trim();
  Chart.defaults.color = v('--muted');
  Chart.defaults.borderColor = v('--rule');
  Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
  Chart.defaults.font.size = 12;
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-chart]').forEach((el) => {
    const c = JSON.parse(el.dataset.chart!);
    const last = c.values.length - 1;
    new Chart(el, {
      type: 'bar',
      data: { labels: c.labels, datasets: [{
        label: c.label, data: c.values, borderRadius: 3, maxBarThickness: 36,
        backgroundColor: c.values.map((_: number, i: number) => (i === last ? v('--p-inc') : v('--control'))),
        hoverBackgroundColor: c.values.map((_: number, i: number) => (i === last ? v('--p-inc') : v('--muted'))),
      }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        scales: {
          x: { grid: { display: false }, border: { display: false } },
          y: { reverse: !!c.invert, title: { display: !!c.yTitle, text: c.yTitle }, beginAtZero: !c.invert, border: { display: false }, ticks: { maxTicksLimit: 5 } },
        },
        plugins: { legend: { display: false }, tooltip: { callbacks: { afterLabel: (ctx: any) => (c.notes ? c.notes[ctx.dataIndex] || '' : '') } } },
      },
    });
  });
</script>
