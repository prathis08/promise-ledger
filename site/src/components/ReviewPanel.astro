---
import { REPO_URL } from '../lib/site';
import { u } from '../lib/site';
const { claim: c } = Astro.props;
const STATUS: Record<string, { label: string; text: string }> = {
  draft: { label: 'Draft', text: 'No human review yet.' },
  'in-review': { label: 'In review', text: 'At least one review recorded; needs two approvals from trusted reviewers.' },
  verified: { label: 'Verified', text: 'Approved by two trusted reviewers with the full checklist.' },
  disputed: { label: 'Disputed', text: 'A trusted reviewer rejected this entry or asked for changes.' },
};
const st = STATUS[c.review_status] ?? STATUS.draft;
const newIssue = `${REPO_URL}/issues/new?template=claim-review.yml&title=${encodeURIComponent(`Review: ${c.id}`)}&claim_id=${encodeURIComponent(c.id)}`;
const DEC: Record<string, string> = { approve: 'Approved', 'request-changes': 'Requested changes', reject: 'Rejected' };
---
<section class={`review st-${c.review_status}`} aria-labelledby="rv-h">
  <h2 id="rv-h">Human review <span class="rv-badge">{st.label}</span></h2>
  <p class="sans small">{st.text}</p>
  {c.reviews.length > 0 && (
    <ul class="rv-list">{c.reviews.map((r: any) => (
      <li><b>{DEC[r.decision]}</b> by <a href={`https://github.com/${r.reviewer}`} rel="noopener">@{r.reviewer}</a>{r.trusted ? '' : ' (community)'} · {r.date}
        {!r.checks_complete && r.decision === 'approve' && <span class="kv"> · checklist incomplete, not counted</span>}
        {r.suggested_verdict && <span class="kv"> · suggested verdict: {r.suggested_verdict}</span>}
        {r.issue && <> · <a href={r.issue} rel="noopener">discussion</a></>}
        {r.notes && <div class="kv">{r.notes}</div>}</li>))}</ul>
  )}
  <p><a class="rv-btn" href={newIssue} rel="noopener">Review this claim on GitHub</a> <span class="kv">Opens a checklist form. Needs a free GitHub account. <a href={u('/review/')}>How reviewing works</a></span></p>
</section>
<style>
  .review { border: 1px solid var(--line); border-left: 4px solid var(--v-unverifiable); border-radius: 6px; padding: 0.75rem 1rem; margin: 1.5rem 0; background: var(--card); }
  .review.st-verified { border-left-color: var(--v-true); }
  .review.st-disputed { border-left-color: var(--v-false); }
  .review.st-in-review { border-left-color: var(--v-in-progress); }
  .review h2 { margin-top: 0; }
  .rv-badge { font-size: 0.8rem; padding: 0.1rem 0.5rem; border-radius: 999px; border: 1px solid currentColor; vertical-align: middle; }
  .rv-list { padding-left: 1.1rem; }
  .rv-btn { display: inline-block; padding: 0.45rem 0.9rem; border-radius: 6px; border: 1px solid var(--line); font-weight: 600; text-decoration: none; }
</style>
