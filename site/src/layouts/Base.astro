---
import { u } from '../lib/site';
import '../styles/global.css';
import { t } from '../i18n/en';
import { getData } from '../lib/data';
import Flag from '../components/Flag.astro';
// title: the page's own name ("Neta Ranking"), shown as "<title> — Sarkari Benchmark".
// fullTitle: replaces the whole <title> (the home page uses it to lead with the site name and what it is).
const { title, fullTitle, description = t.tagline, image = '/og.png', type = 'website' } = Astro.props;
const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://sarkaribenchmark.site');
const pageTitle = fullTitle ?? (title ? `${title} — ${t.siteName}` : t.siteName);
const canonical = new URL(path, site).href;
const ogImage = new URL(u(image), site).href;
const desc = description.length > 160 ? description.slice(0, 157).trimEnd() + '…' : description;
const { fixture } = getData();
const nav = [['/', 'Scoreboard'], ['/netas/', 'Neta Ranking'], ['/claims/', 'All claims'], ['/suites/accuracy/', 'Statements'], ['/suites/promises/', 'Promises'], ['/benchmarks/', 'World rankings'], ['/methodology/', t.nav.methodology], ['/data/', t.nav.data]];
const cur = (h: string) => { const b = u(h); return h === '/' ? path === b || path === u('') : path.startsWith(b); };
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0e0f11" />
  <meta property="og:site_name" content={t.siteName} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
  <link rel="icon" type="image/png" sizes="192x192" href={u('/icon-192.png')} />
  <link rel="apple-touch-icon" href={u('/icon-192.png')} />
  <link rel="sitemap" type="application/xml" href={u('/sitemap.xml')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>try { if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}</script>
  <slot name="head" />
</head>
<body>
  <header class="site" id="top"><div class="wrap">
    <a class="brand" href={u('/')}>
      <Flag height={16} />
      {t.siteName}
    </a>
    <nav class="main" aria-label="Main" id="nav">{nav.map(([h, l]) => <a href={u(h)} aria-current={cur(h) ? 'page' : undefined}>{l}</a>)}<a class="only-phone" href={u('/review/')} aria-current={cur('/review/') ? 'page' : undefined}>Help check claims</a></nav>
    <button class="btn ghost theme-btn" type="button" id="theme" aria-label="Switch to light mode" title="Switch to light mode"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" /></svg></button>
    <a class="btn cta" href={u('/review/')}>Help check claims</a>
    <button class="btn ghost menu-btn" type="button" aria-controls="nav" aria-expanded="false" id="menu">Menu</button>
  </div></header>
  <main><div class="wrap">
    {fixture && <div class="banner fixture" role="status">{t.fixtureBanner}</div>}
    <slot />
  </div></main>
  <footer class="site"><div class="wrap">
    <a class="brand" href={u('/')}><Flag height={14} />{t.siteName}</a>
    <span>{t.footer}</span>
  </div></footer>
  <script is:inline>
    (() => { const b = document.getElementById('menu'), h = document.getElementById('top');
      b && b.addEventListener('click', () => { const o = h.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); b.textContent = o ? 'Close' : 'Menu'; }); })();
    (() => { const t = document.getElementById('theme'), d = document.documentElement;
      const label = () => { const l = d.dataset.theme === 'light' ? 'Switch to dark mode' : 'Switch to light mode'; t.setAttribute('aria-label', l); t.title = l; };
      label();
      t.addEventListener('click', () => { if (d.dataset.theme === 'light') { delete d.dataset.theme; try { localStorage.removeItem('theme'); } catch (e) {} } else { d.dataset.theme = 'light'; try { localStorage.setItem('theme', 'light'); } catch (e) {} } label(); location.reload(); }); })();
  </script>
</body>
</html>
