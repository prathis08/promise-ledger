---
import { u } from '../lib/site';
import Base from '../layouts/Base.astro';
import Cell from '../components/Cell.astro';
import { getData } from '../lib/data';
import { getBench, f3, fd } from '../lib/bench';
import { cStat, DOMAINS, PARTIES, ERA_START_SLACK, ERA_END_SLACK } from '../lib/scoring';
const b = getBench();
const idxMeta = new Map(getData().indices.map((i) => [i.slug, i]));
const dn = (id: string | null) => DOMAINS.find((d) => d.id === id)?.name ?? '';
const W = 150, H = 30;
const allYears = b.indices.flatMap((r) => r.series.map((p) => p.year));
const y0 = Math.min(...allYears), y1 = Math.max(...allYears);
const X = (y: number) => 3 + ((y - y0) / Math.max(1, y1 - y0)) * (W - 6), Y = (n: number) => 3 + (1 - n) * (H - 6);
const spark = (r: (typeof b.indices)[number]) => r.series.map((p) => `${X(p.year).toFixed(1)},${Y(p.norm).toFixed(1)}`).join(' ');
const cls = (d: number) => (d > 0.0005 ? 'pos' : d < -0.0005 ? 'neg' : 'flat');
const arrow = (d: number) => (d > 0.0005 ? '▲' : d < -0.0005 ? '▼' : '●');
const pv = (p: { year: number; value: number; outOf: number | null }, rank: boolean) => `${p.year}: ${p.value}${rank && p.outOf ? `/${p.outOf}` : ''}`;
const data = b.indices.map((r) => ({ x: r.excludable, e: Object.fromEntries(PARTIES.map((p) => [p.id, r.eras[p.id] ? { s: r.eras[p.id]!.score, d: r.eras[p.id]!.delta, y: r.eras[p.id]!.perYear } : null])) }));
---
<Base title="Benchmarks">
  <h1>Suite C: External Benchmarks by era</h1>
  <p class="muted">India's position in global indices, measured over each party's era at the centre: <b>INC (UPA)</b> from the edition at or before 2004 to the 2014 edition, and <b>BJP (NDA)</b> from the 2014 edition to the latest. Every edition is normalised to 0–1, higher is better. An index scores 1 for a party if it improved during that era, 0.5 if flat, 0 if it declined.</p>
  <p class="toggle"><label><input type="checkbox" id="excl" /> Exclude flagged indices (comparability or discontinuation)</label></p>
  <div class="tablewrap"><table class="dense">
    <thead><tr><th>Party (era)</th><th>Share of indices improved</th><th class="r">Mean Δ</th><th class="r">Mean Δ per year</th></tr></thead>
    <tbody>{PARTIES.map((p) => { const c = cStat(b.indices, p.id, false); return (
      <tr><th scope="row">{p.label}</th><td id={`c-${p.id}`}><Cell st={c} extra={`up ${c.improved} / down ${c.declined} / flat ${c.flat}`} /></td>
        <td class="r num" id={`d-${p.id}`}>{c.meanDelta == null ? '—' : fd(c.meanDelta)}</td><td class="r num" id={`y-${p.id}`}>{c.meanPerYear == null ? '—' : fd(c.meanPerYear)}</td></tr>); })}</tbody>
  </table></div>
  <p class="kv">Eras are of different length (about 10 and 12 years), so compare Δ per year as well as total Δ. The 2014 edition is the end of the INC era and the start of the BJP era; most indices publish with a lag of a year or more, so it mostly reflects conditions under the previous government.</p>

  <div class="tablewrap"><table class="dense">
    <thead><tr><th>Index</th><th>Domain</th>{PARTIES.map((p) => <th class="r">{p.name} era: start → end, Δ</th>)}<th>Trend {y0}–{y1}</th><th>Flags</th></tr></thead>
    <tbody>{b.indices.map((r) => (
      <tr data-x={r.excludable ? '1' : '0'}>
        <th scope="row"><a href={`#${r.slug}`}>{r.name}</a></th><td>{dn(r.domain)}</td>
        {PARTIES.map((p) => { const e = r.eras[p.id]; return e
          ? <td class="r num">{pv(e.start, r.isRank)} → {pv(e.end, r.isRank)}<br /><span class={cls(e.delta)}>{arrow(e.delta)} {fd(e.delta)}</span>{e.perYear != null && <span class="kv"> ({fd(e.perYear)}/yr)</span>}</td>
          : <td class="r kv">not measurable: {r.eraGaps[p.id]}</td>; })}
        <td><svg class="spark" width={W} height={H} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${r.name} normalised trend`}>
          <line x1={X(2014)} x2={X(2014)} y1="0" y2={H} class="era" /><polyline points={spark(r)} /></svg></td>
        <td>{r.flags.map((f) => <div><span class="flag">{f.kind}</span> <span class="kv">{f.text}</span></div>)}</td>
      </tr>
    ))}</tbody>
  </table></div>
  <p class="kv">Rank indices: 1 − (rank − 1) / (out_of − 1). Score indices: value / out_of (value as is when out_of is null, as in V-Dem). An era's first edition may be up to {ERA_START_SLACK} years after the era starts (flagged "late-start"); a closed era's last edition must be within {ERA_END_SLACK} years of its end. Vertical line in the trend: 2014. The toggle removes indices with a comparability or discontinuation flag.</p>

  <h2>Index details</h2>
  {b.indices.map((r) => { const m = idxMeta.get(r.slug)!; return (
    <section id={r.slug} data-x={r.excludable ? '1' : '0'}>
      <h3>{r.name}</h3>
      <p class="kv">{m.publisher}{m.url && /^https?:/.test(m.url) && <> · <a href={m.url} rel="noopener">source</a></>} · metric: {m.metric}{m.out_of_label && ` · ${m.out_of_label}`}</p>
      {m.methodology_note && <p><strong>Methodology.</strong> {m.methodology_note}</p>}
      {m.govt_response.length > 0 && <>{m.govt_response.map((g) => <p><strong>Government response.</strong> {g.url && /^https?:/.test(g.url) ? <a href={g.url} rel="noopener">{g.title || g.url}</a> : g.title} {g.summary}</p>)}</>}
      {m.related_claims.length > 0 && <p class="kv">Related claims: {m.related_claims.map((id, i) => <>{i > 0 && ', '}{getData().claims.some((c) => c.id === id) ? <a href={u(`/claims/${id}/`)}>{id}</a> : id}</>)}</p>}
    </section>); })}

  <script type="application/json" id="bd" set:html={JSON.stringify(data)} />
  <script>
    import { stat, PARTIES } from '../lib/scoring';
    const D = JSON.parse(document.getElementById('bd')!.textContent!);
    const cb = document.getElementById('excl') as HTMLInputElement;
    const f3 = (x: number | null) => (x == null ? '—' : x.toFixed(3));
    const sg = (x: number | null) => (x == null ? '—' : (x >= 0 ? '+' : '−') + Math.abs(x).toFixed(3));
    const avg = (v: number[]) => (v.length ? v.reduce((a, b) => a + b, 0) / v.length : null);
    function upd() {
      document.querySelectorAll<HTMLElement>('[data-x]').forEach((el) => (el.hidden = cb.checked && el.dataset.x === '1'));
      for (const p of PARTIES) {
        const e = D.filter((r: any) => !(cb.checked && r.x)).map((r: any) => r.e[p.id]).filter(Boolean);
        const s = stat(e.map((x: any) => x.s));
        const up = e.filter((x: any) => x.s === 1).length, dn = e.filter((x: any) => x.s === 0).length;
        document.getElementById('c-' + p.id)!.innerHTML = `<span class="cell${s.sufficient ? '' : ' na'}"><span class="main">${s.sufficient ? f3(s.mean) : 'insufficient data'}</span><span class="sub">${s.ci && s.sufficient ? `CI [${s.ci[0].toFixed(2)}, ${s.ci[1].toFixed(2)}] · ` : ''}n=${s.n}</span><span class="sub">up ${up} / down ${dn} / flat ${e.length - up - dn}</span></span>`;
        document.getElementById('d-' + p.id)!.textContent = sg(avg(e.map((x: any) => x.d)));
        document.getElementById('y-' + p.id)!.textContent = sg(avg(e.filter((x: any) => x.y != null).map((x: any) => x.y)));
      }
    }
    cb.addEventListener('input', upd); upd();
  </script>
</Base>

<style>
  .spark .era { stroke: var(--muted); stroke-dasharray: 2 2; stroke-width: 1; }
</style>
