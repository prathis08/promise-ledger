---
import Base from '../../layouts/Base.astro';
import ClaimCard from '../../components/ClaimCard.astro';
import Badge from '../../components/Badge.astro';
import { t } from '../../i18n/en';
import { getData, VERDICTS, year } from '../../lib/data';
const { claims } = getData();
const count = (f: (c: any) => boolean) => claims.filter(f).length;
const speakers = [...new Set(claims.map((c) => c.speaker))].sort();
const topics = [...new Set(claims.flatMap((c) => c.topics))].sort();
const years = [...new Set(claims.map((c) => year(c.date)))].sort().reverse();
const types = [...new Set(claims.map((c) => c.claim_type))].sort();
const drafts = count((c) => c.review_status === 'draft');
const index = claims.map((c) => ({
  id: c.id, s: c.speaker, v: c.verdict, t: c.topics, y: year(c.date), ct: c.claim_type,
  q: [c.quote_english, c.quote_original, c.summary, c.venue, c.speaker, c.topics.join(' ')].join(' ').toLowerCase(),
}));
const h = t.home;
---
<Base title={h.title}>
  <h1>Claims</h1>
  <p class="muted">{t.tagline}</p>
  {drafts > 0 && <p class="banner draft">{t.draftCount(drafts)}</p>}

  <h2 style="border:0;margin-top:1em">{h.byVerdict}</h2>
  <div class="counters">
    {VERDICTS.map((v) => <div class="counter"><b>{count((c) => c.verdict === v)}</b><Badge verdict={v} /></div>)}
  </div>
  <h2 style="border:0;margin-top:.5em">{h.bySpeaker}</h2>
  <div class="counters">
    {speakers.map((s) => <div class="counter"><b>{count((c) => c.speaker === s)}</b>{s}</div>)}
  </div>

  <form class="filters" id="filters" role="search" onsubmit="return false">
    <label class="search">{h.search}<input type="search" id="q" placeholder={h.search} autocomplete="off" /></label>
    <label>{h.speaker}<select id="f-s"><option value="">{h.all}</option>{speakers.map((s) => <option>{s}</option>)}</select></label>
    <label>{h.verdict}<select id="f-v"><option value="">{h.all}</option>{VERDICTS.map((v) => <option value={v}>{t.verdicts[v]}</option>)}</select></label>
    <label>{h.topic}<select id="f-t"><option value="">{h.all}</option>{topics.map((s) => <option>{s}</option>)}</select></label>
    <label>{h.year}<select id="f-y"><option value="">{h.all}</option>{years.map((s) => <option>{s}</option>)}</select></label>
    <label>{h.type}<select id="f-c"><option value="">{h.all}</option>{types.map((s) => <option value={s}>{t.claimTypes[s] ?? s}</option>)}</select></label>
    <label>&nbsp;<button type="button" id="reset">{h.reset}</button></label>
  </form>
  <p class="sans small muted" id="count" aria-live="polite">{h.results(claims.length, claims.length)}</p>

  <div id="list">{claims.map((c) => <ClaimCard claim={c} />)}</div>
  <p id="none" class="muted" hidden>{h.none}</p>

  <script type="application/json" id="claim-index" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
  <script is:inline>
    const idx = JSON.parse(document.getElementById('claim-index').textContent);
    const $ = (id) => document.getElementById(id);
    const cards = new Map([...document.querySelectorAll('#list .card')].map((el) => [el.dataset.id, el]));
    const ids = ['q', 'f-s', 'f-v', 'f-t', 'f-y', 'f-c'];
    const apply = () => {
      const q = $('q').value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const [s, v, tp, y, c] = ids.slice(1).map((i) => $(i).value);
      let n = 0;
      for (const r of idx) {
        const ok = (!s || r.s === s) && (!v || r.v === v) && (!tp || r.t.includes(tp)) && (!y || r.y === y) && (!c || r.ct === c) && q.every((w) => r.q.includes(w));
        cards.get(r.id).hidden = !ok; if (ok) n++;
      }
      $('count').textContent = n + ' of ' + idx.length + ' claims';
      $('none').hidden = n > 0;
      const p = new URLSearchParams(); ids.forEach((i) => $(i).value && p.set(i, $(i).value));
      history.replaceState(null, '', p.toString() ? '?' + p : location.pathname);
    };
    const p = new URLSearchParams(location.search); ids.forEach((i) => { if (p.get(i)) $(i).value = p.get(i); });
    ids.forEach((i) => $(i).addEventListener('input', apply));
    $('reset').addEventListener('click', () => { ids.forEach((i) => ($(i).value = '')); apply(); });
    apply();
  </script>
</Base>
