---
import PartyLogo from '../../components/PartyLogo.astro';
import { u } from '../../lib/site';
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { t } from '../../i18n/en';
import Cell from '../../components/Cell.astro';
import { getData } from '../../lib/data';
import { getBench, f3 } from '../../lib/bench';
import { SUITES, VERDICT_SCORES_B, DOMAINS } from '../../lib/scoring';
const b = getBench();
const cases = b.cases.filter((c) => c.suite === 'B').sort((a, c) => c.date.localeCompare(a.date));
const prow = b.rows.filter((r) => r.kind === 'party');
const st = { n: prow.reduce((a, r) => a + r.B.n, 0) };
const unscored = getData().claims.filter((c) => c.scored === false && c.claim_type === 'promise');
const dn = (id: string | null) => DOMAINS.find((d) => d.id === id)?.name ?? '';
const num = (x: number) => (Math.abs(x) >= 1000 ? x.toLocaleString('en-US') : String(x));
const Bar = (v: number | null) => v;
const SUM = new Map(getData().claims.map((x) => [x.id, x.summary || x.id]));
const title = (id: string) => { const s = SUM.get(id) ?? id; return s.length > 110 ? s.slice(0, 107).trimEnd() + '…' : s; };
---
<Base title="Did they keep their promises? BJP vs Congress promise tracker" description="Every promise by BJP and Congress leaders we checked: kept on time, late, not delivered or still in progress, and how close each came to its target.">
  <h1>Did they keep their promises?</h1>
  <p class="lede">Every promise we checked. Each one earns points: {Object.entries(VERDICT_SCORES_B).map(([k, v]) => `${(t.verdicts[k] ?? k).toLowerCase()} = ${Math.round(v * 100)}`).join(', ')}. Promises whose deadline hasn't come yet are not scored. A party's score is the average, out of 100.</p>
  <div class="tablewrap"><table class="dense"><thead><tr><th>Party</th><th>Score</th></tr></thead><tbody>{prow.map((r) => <tr><th scope="row"><span class="party"><PartyLogo party={r.party} size={16} />{r.label}</span></th><td><Cell st={r.B} extra={`kept on time: ${Math.round((r.B.share ?? 0) * 100)}% · deadline not reached: ${r.B.pending} · could not be scored: ${r.B.abstained}`} /></td></tr>)}</tbody></table></div>
  <div class="tablewrap"><table class="dense">
    <thead><tr><th>Promise</th><th>When</th><th>Party</th><th>Who</th><th>Topic</th><th>Result</th><th class="r">Points</th><th>How sure</th></tr></thead>
    <tbody>{cases.map((c) => (
      <tr><td><a href={u(`/claims/${c.id}/`)} class="clink">{title(c.id)}</a></td><td class="num">{c.date}</td><td><span class="party"><PartyLogo party={c.party} size={14} />{c.party}</span></td><td>{c.speaker}</td><td>{dn(c.domain)}</td>
        <td><Badge verdict={c.verdict} /></td><td class="r num">{c.notYetDue ? 'not due yet' : c.score == null ? '—' : Math.round(c.score * 100)}</td><td>{t.confidence[c.confidence]}</td></tr>
    ))}</tbody>
  </table></div>
  <ul class="notes-list">
    <li><b>—</b> means the promise could not be scored.</li>
    <li><b>{cases.length} promises</b> listed; <b>{st.n}</b> scored.</li>
    {unscored.length > 0 && <li><b>Background only:</b> these are shown for context but not scored: {unscored.map((c, i) => <>{i > 0 && ', '}<a href={u(`/claims/${c.id}/`)}>{title(c.id)}</a></>)}.</li>}
  </ul>

  <h2>How close did they get to the target?</h2>
  <ul class="notes-list">
    <li><b>What it shows:</b> for promises with a number attached (say, 175 GW of solar power), how much of the way from the starting point to the target was covered.</li>
    <li><b>100%</b> means the target was reached.</li>
    <li><b>Two moments:</b> we show the figure at the deadline and for the latest data.</li>
  </ul>
  {b.gaps.length === 0 ? <p class="muted">No promises with a number attached yet.</p> : (
    <div class="tablewrap"><table class="dense">
      <thead><tr><th>Promise</th><th>Target</th><th>Starting point</th><th>By the deadline</th><th>Latest</th><th>Things to note</th></tr></thead>
      <tbody>{b.gaps.map((g) => (
        <tr>
          <td><a href={u(`/claims/${g.id}/`)} class="clink">{title(g.id)}</a></td>
          <td class="num">{num(g.target)}<br /><span class="kv">{g.unit}</span></td>
          <td class="num">{num(g.baseline.y)}<br /><span class="kv">{g.baseline.x}</span></td>
          <td>{g.gapAtDeadline == null ? <span class="na">no figure from before the deadline</span> : <><div class="bar" role="img" aria-label={`gap closed at deadline ${g.gapAtDeadline.toFixed(2)}`}><i style={`width:${g.gapAtDeadline * 100}%`}></i></div><span class="num">{Math.round(g.gapAtDeadline * 100)}% of the way</span> <span class="kv">{num(g.atDeadline!.y)} @ {g.atDeadline!.x}</span></>}</td>
          <td><div class="bar" role="img" aria-label={`gap closed latest ${g.gapLatest.toFixed(2)}`}><i style={`width:${g.gapLatest * 100}%`}></i></div><span class="num">{Math.round(g.gapLatest * 100)}% of the way</span> <span class="kv">{num(g.latest.y)} @ {g.latest.x}</span></td>
          <td>{g.caveats.map((c) => <span class="flag" title={c}>note</span>)}{g.caveats.map((c) => <div class="kv">{c}</div>)}</td>
        </tr>
      ))}</tbody>
    </table></div>
  )}
</Base>
