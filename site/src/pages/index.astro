---
import { u } from '../lib/site';
import Base from '../layouts/Base.astro';
import Cell from '../components/Cell.astro';
import Donut from '../components/Donut.astro';
import PartyLogo from '../components/PartyLogo.astro';
import { getData } from '../lib/data';
import { getBench, f3, fci, fd } from '../lib/bench';
import { DEFAULT_WEIGHTS, MIN_N, PARTIES, RATES } from '../lib/scoring';
const b = getBench();
const { claims } = getData();
const drafts = claims.filter((c) => c.review_status === 'draft').length;
const verified = claims.filter((c) => c.review_status === 'verified').length;
const count = (p: string) => claims.filter((c) => c.party === p && c.scored !== false).length;
const partyRows = b.rows.filter((r) => r.kind === 'party');
const bg = (s: number | null) => s == null ? '' : s >= 0.5 ? `background:color-mix(in srgb, var(--v-true) ${Math.round((s - 0.5) * 120)}%, var(--card))` : `background:color-mix(in srgb, var(--v-false) ${Math.round((0.5 - s) * 120)}%, var(--card))`;
// Verdict mix across statements and promises, for the party scorecards.
const combined = (pid: string) => {
  const acc = new Map<string, number>();
  for (const k of ['A', 'B'] as const) for (const x of b.mix[pid][k]) acc.set(x.verdict, (acc.get(x.verdict) ?? 0) + x.n);
  return [...acc].map(([verdict, n]) => ({ verdict, n })).filter((x) => x.n > 0);
};
const NAME: Record<string, string> = { BJP: 'BJP', INC: 'Congress' };
const ov = Object.fromEntries(partyRows.map((r) => [r.party, r.overall?.score ?? null]));
const lead = ov.BJP != null && ov.INC != null ? (ov.BJP > ov.INC ? 'BJP' : 'INC') : null;
const finding = lead == null ? '' : `Right now ${NAME[lead]} scores a little higher (${f3(Math.max(ov.BJP!, ov.INC!))} vs ${f3(Math.min(ov.BJP!, ov.INC!))} out of 100), ${b.h2h.overall.significant ? 'and the gap is big enough to be real.' : 'but the gap is small enough that it could be down to which claims were picked, so neither party is clearly ahead.'}`;
const clientData = { parties: b.parties.map((p) => ({ id: p.id, A: p.pools.A, B: p.pools.B, C: p.cPool })), defaults: DEFAULT_WEIGHTS };
const pct = (x: number | null | undefined) => (x == null ? '—' : `${(x * 100).toFixed(0)}%`);
const pci = (c: [number, number] | null) => (c ? `likely ${(c[0] * 100).toFixed(0)}–${(c[1] * 100).toFixed(0)}%` : '');
const pp = (d: { diff: number | null }) => d.diff == null ? '—' : `${d.diff >= 0 ? '+' : '−'}${Math.abs(d.diff * 100).toFixed(0)} points`;
const who = (d: { diff: number | null; significant: boolean }) => d.diff == null ? '—' : !d.significant ? 'Too close to call' : d.diff > 0 ? `${NAME[PARTIES[0].id]} worse` : `${NAME[PARTIES[1].id]} worse`;
const VLABEL: Record<string, string> = { true: 'True / kept', 'in-progress': 'Still in progress', 'missed-deadline': 'Missed the deadline', misleading: 'Misleading', unachieved: 'Not delivered', false: 'False', unverifiable: "Can't be checked", 'not-yet-due': 'Deadline not reached' };
const w = (k: 'A' | 'B' | 'C') => Math.round(DEFAULT_WEIGHTS[k] * 100);
const dtxt = (d: { diff: number | null; significant: boolean }) => d.diff == null ? '—' : `${fd(d.diff)} · ${d.significant ? 'a real gap' : 'too close to call'}`;
// Structured data: the site and its publisher, plus a search box Google can show.
const siteUrl = Astro.site ?? new URL('https://sarkaribenchmark.site');
const ld = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'WebSite', '@id': new URL('/#website', siteUrl).href, name: 'Sarkari Benchmark', alternateName: 'Promise Ledger', url: new URL(u('/'), siteUrl).href, inLanguage: 'en-IN',
        potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: new URL(u('/claims/'), siteUrl).href + '?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
      { '@type': 'Organization', '@id': new URL('/#org', siteUrl).href, name: 'Sarkari Benchmark', url: new URL(u('/'), siteUrl).href, logo: new URL(u('/icon-192.png'), siteUrl).href, sameAs: ['https://github.com/shreyashsiddharth-collab/promise-ledger'] },
    ],
}).replace(/</g, '\\u003c');
---
<Base fullTitle="Sarkari Benchmark: BJP vs Congress promises and claims, fact-checked" description={`Did BJP and Congress keep their word? ${claims.length} statements and promises by Narendra Modi, Manmohan Singh, Amit Shah, Rahul Gandhi and other leaders, checked against official data and scored out of 100.`}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <div class="titlerow">
    <div>
      <h1>BJP vs Congress: who kept their word?</h1>
      <p class="lede">We collected {claims.length} things that ministers, Chief Ministers and party leaders said or promised, and checked each one against official data. Each party gets a score out of 100: higher means more of what they said was true and more of what they promised was delivered. {finding} <a href={u('/methodology/')}>How we score</a></p>
    </div>
  </div>
  <div class="banner draft" role="status"><span>Early results: {verified === 0 ? 'none' : verified} of the {claims.length} entries have been double-checked by people yet, and many were first researched with AI. Treat the scores as rough.</span> <a href={u('/review/')}>Help check them</a></div>

  <section class="vs" aria-label="Head to head">
    {partyRows.map((r) => { const m = combined(r.party); return (
      <article class="vs-card panel" data-party={r.party}>
        <header class="vs-h"><PartyLogo party={r.party} size={24} /><h2>{r.label}</h2></header>
        <div class="vs-body">
          <Donut size={156} thick={18} segments={m.map((x) => ({ value: x.n, color: `var(--v-${x.verdict})`, label: VLABEL[x.verdict] }))} center={f3(r.overall?.score)} centerId={`ov-${r.party}`} sub="score out of 100" label={`${r.label}: ${m.map((x) => `${VLABEL[x.verdict]} ${x.n}`).join(', ')}`} />
          <div class="vs-side">
            <div class="kv nowrap" id={`ci-${r.party}`}>Likely range: {fci(r.overall?.ci ?? null)}</div>
            <ul class="legend vlist">{m.map((x) => <li><i style={`background:var(--v-${x.verdict})`}></i>{VLABEL[x.verdict]}<b>{x.n}</b></li>)}</ul>
          </div>
        </div>
        <a class="foot" href={u('/claims/')}>Based on {count(r.party)} claims · see them all →</a>
      </article>); })}
    <article class="vs-card panel diff">
      <header class="vs-h"><h2>Difference (BJP minus Congress)</h2></header>
      <div class="gapfig" id="ov-diff">{b.h2h.overall.diff == null ? '—' : fd(b.h2h.overall.diff)}</div>
      <div class="kv" id="ci-diff">Likely range: {fci(b.h2h.overall.ci)} points</div>
      <p class="gapread" id="sig-diff">{b.h2h.overall.significant ? 'This gap is big enough to be real.' : 'Too close to call: the gap could easily be zero.'}</p>
      <form class="sliders" id="weights" onsubmit="return false">
        <p class="kv slhint">What matters most to you? Move the sliders to change the score.</p>
        <label>True statements<input type="range" min="0" max="100" step="5" value={w('A')} id="wA" /><output class="num" id="oA"></output></label>
        <label>Promises kept<input type="range" min="0" max="100" step="5" value={w('B')} id="wB" /><output class="num" id="oB"></output></label>
        <label>World rankings<input type="range" min="0" max="100" step="5" value={w('C')} id="wC" /><output class="num" id="oC"></output></label>
        <label class="toggle"><span><input type="checkbox" id="excl" /> Skip rankings with known problems</span></label>
      </form>
    </article>
  </section>
  <p class="kv" id="formula">The score mixes the three parts equally unless you change the sliders.</p>

  <h2>How often were they wrong?</h2>
  <p class="muted">Each number is a share of that party's own claims, so a party with fewer claims is not punished for it. Lower is better on every row.</p>
  <div class="tablewrap"><table class="dense rates">
    <thead><tr><th>What we counted</th>{PARTIES.map((p) => <th class="r"><span class="party"><PartyLogo party={p.id} size={14} />{NAME[p.id]}</span></th>)}<th class="r">Difference</th><th>Verdict</th></tr></thead>
    <tbody>{RATES.map((r) => (
      <tr><th scope="row">{r.label}<div class="kv">{r.help}</div></th>
        {PARTIES.map((p) => { const st = b.rates[p.id][r.id]; return (
          <td class="r"><span class={`big2 ${st.sufficient ? '' : 'na'}`}>{st.sufficient ? pct(st.mean) : '—'}</span><div class="kv">{st.n ? `${Math.round((st.mean ?? 0) * st.n)} out of ${st.n}` : 'none yet'}</div>{st.sufficient ? <div class="kv">{pci(st.ci)}</div> : <div class="kv">too few to judge</div>}</td>); })}
        <td class="r num">{pp(b.rateDiffs[r.id])}</td>
        <td>{who(b.rateDiffs[r.id])}</td></tr>
    ))}</tbody>
  </table></div>
  <p class="kv">"Too close to call" means the gap is small enough that it could be down to chance or to which claims were picked. Promises whose deadline hasn't come yet, and claims that can't be checked, are left out.</p>

  <h2>What happened to each claim</h2>
  <div class="mixgrid">
    {PARTIES.map((p) => (['A', 'B'] as const).map((k) => { const m = b.mix[p.id][k]; const tot = m.reduce((a, x) => a + x.n, 0); return (
      <article class="panel mixcard">
        <header class="vs-h" data-party={p.id}><PartyLogo party={p.id} size={18} /><h3>{NAME[p.id]} · {k === 'A' ? 'things they said' : 'things they promised'}</h3></header>
        <div class="mixbody">
          <Donut size={128} thick={16} segments={m.map((x) => ({ value: x.n, color: `var(--v-${x.verdict})`, label: VLABEL[x.verdict] }))} center={String(tot)} sub={k === 'A' ? 'statements' : 'promises'} label={`${NAME[p.id]} ${k === 'A' ? 'statements' : 'promises'}: ${m.map((x) => `${VLABEL[x.verdict]} ${x.n}`).join(', ')}`} />
          <ul class="legend vlist">{m.map((x) => <li><i style={`background:var(--v-${x.verdict})`}></i>{VLABEL[x.verdict]}<b>{x.n} · {(x.share * 100).toFixed(0)}%</b></li>)}</ul>
        </div>
        <a class="foot" href={u(k === 'A' ? '/suites/accuracy/' : '/suites/promises/')}>See every {k === 'A' ? 'statement' : 'promise'} →</a>
      </article>); }))}
  </div>

  <h2>Which party did better on each topic?</h2>
  <div class="panel spread" role="img" aria-label={`Score by topic, out of 100: ${b.domains.map((d) => `${d.name}: ${PARTIES.map((p) => `${p.name} ${d.byParty[p.id].AB.sufficient ? f3(d.byParty[p.id].AB.mean) : 'too few to score'}`).join(', ')}`).join('; ')}`}>
    <ul class="legend sp-legend">{PARTIES.map((p) => <li data-party={p.id}><PartyLogo party={p.id} size={14} />{p.label}</li>)}<li class="sp-mid">The line marks 50</li></ul>
    {b.domains.map((d) => (
      <div class="sp-row">
        <div class="sp-name">{d.name}</div>
        <div class="sp-bars">
          {PARTIES.map((p) => { const st = d.byParty[p.id].AB; return (
            <div class="sp-bar" data-party={p.id} title={`${p.name} · ${d.name}: ${st.sufficient ? f3(st.mean) : 'too few to score'} (from ${st.n} claims)`}>
              <div class="sp-track">{st.sufficient && <i style={`width:${(st.mean! * 100).toFixed(1)}%`}></i>}</div>
              <span class="sp-val">{st.sufficient ? f3(st.mean) : <span class="kv">too few to score</span>}{st.sufficient && <span class="kv"> from {st.n}</span>}</span>
            </div>); })}
        </div>
      </div>
    ))}
  </div>
  <p class="kv">Each bar is the party's average score, out of 100, for everything they said or promised on that topic. Longer is better. When a party has fewer than {MIN_N} claims on a topic, we don't draw a bar.</p>

  <h2>The three parts of the score</h2>
  <div class="tablewrap"><table class="dense">
    <thead><tr><th>Part</th>{partyRows.map((r) => <th><span class="party"><PartyLogo party={r.party} size={14} />{r.label}</span></th>)}<th>Difference (BJP minus Congress)</th></tr></thead>
    <tbody>
      <tr><th scope="row"><a href={u('/suites/accuracy/')}>Were their statements true?</a></th>{partyRows.map((r) => <td><Cell st={r.A} extra={`fully true: ${pct(r.A.share)}`} /></td>)}<td class="num">{dtxt(b.h2h.A)}</td></tr>
      <tr><th scope="row"><a href={u('/suites/promises/')}>Did they keep their promises?</a></th>{partyRows.map((r) => <td><Cell st={r.B} extra={`kept on time: ${pct(r.B.share)} · deadline not reached: ${r.B.pending}`} /></td>)}<td class="num">{dtxt(b.h2h.B)}</td></tr>
      <tr><th scope="row"><a href={u('/benchmarks/')}>Did India's world rankings improve?</a></th>{partyRows.map((r) => <td>{r.C && <Cell st={r.C} extra={`${r.C.improved} got better, ${r.C.declined} got worse`} />}</td>)}<td class="num">{dtxt(b.h2h.C)}</td></tr>
    </tbody>
  </table></div>
  <p class="kv">All scores are out of 100; higher is better. World rankings compare India's place in global indices at the start and end of each party's time in power (Congress: 2004 to 2014, BJP: 2014 to now). Where there are fewer than {MIN_N} claims, we don't show a score.</p>

  <h2>Scores by leader</h2>
  <div class="tablewrap"><table class="dense">
    <thead><tr><th>Who</th><th>Party</th><th>True statements</th><th>Promises kept</th></tr></thead>
    <tbody>
      {b.rows.map((r) => (
        <tr class={`k-${r.kind}`}>
          <th scope="row">{r.kind === 'party' ? <b>{r.label}</b> : r.kind === 'level' ? <span>↳ {r.label}</span> : <span class="muted">· {r.label}</span>}</th>
          <td><span class="party"><PartyLogo party={r.party} size={14} />{NAME[r.party] ?? r.party}</span></td>
          <td><Cell st={r.A} /></td>
          <td><Cell st={r.B} /></td>
        </tr>
      ))}
    </tbody>
  </table></div>
  <p class="kv">First each party, then by job (Union ministers, Chief Ministers, party leaders), then each person with at least 3 checked claims.</p>

  <h2>Scores by topic</h2>
  <div class="tablewrap"><table class="dense heat2">
    <thead><tr><th rowspan="2">Topic</th>{PARTIES.map((p) => <th colspan="3"><span class="party"><PartyLogo party={p.id} size={14} />{NAME[p.id]}</span></th>)}</tr><tr>{PARTIES.map(() => <><th>Said</th><th>Promised</th><th>Rankings</th></>)}</tr></thead>
    <tbody>{b.domains.map((d) => (
      <tr><th scope="row">{d.name}</th>{PARTIES.map((p) => [d.byParty[p.id].A, d.byParty[p.id].B, d.byParty[p.id].C].map((st) => st.sufficient
        ? <td class="c" style={bg(st.mean)}><b>{f3(st.mean)}</b><span>{st.n} checked</span></td>
        : <td class="c na">{st.n === 0 ? 'none' : `only ${st.n}`}</td>))}</tr>
    ))}</tbody>
  </table></div>
  <p class="kv">Scores out of 100. Green means mostly good, red mostly bad. Each claim is counted under its main topic only. Grey cells have too few claims to score.</p>

  <script type="application/json" id="bench-data" set:html={JSON.stringify(clientData)} />
  <script>
    import { overall, diffOverall } from '../lib/scoring';
    const $ = (id: string) => document.getElementById(id)!;
    const D = JSON.parse($('bench-data').textContent!);
    const f3 = (x: number | null) => (x == null ? '—' : (x * 100).toFixed(1));
    const fci = (c: number[] | null) => (c ? `${(c[0] * 100).toFixed(0)} to ${(c[1] * 100).toFixed(0)}` : '');
    const sg = (x: number) => (x >= 0 ? '+' : '−') + Math.abs(x * 100).toFixed(1);
    function update() {
      const w = { A: +($('wA') as HTMLInputElement).value, B: +($('wB') as HTMLInputElement).value, C: +($('wC') as HTMLInputElement).value };
      const excl = ($('excl') as HTMLInputElement).checked;
      for (const k of ['A', 'B', 'C']) $('o' + k).textContent = String(w[k as 'A']);
      const pools = D.parties.map((p: any) => ({ A: p.A, B: p.B, C: p.C.filter((c: any) => !(excl && c.x)).map((c: any) => c.s) }));
      D.parties.forEach((p: any, i: number) => {
        const o = overall(pools[i], w);
        $('ov-' + p.id).textContent = f3(o.score);
        $('ci-' + p.id).textContent = `Likely range: ${fci(o.ci)}`;
      });
      const d = diffOverall(pools[0], pools[1], w);
      $('ov-diff').textContent = d.diff == null ? '—' : sg(d.diff);
      $('ci-diff').textContent = `Likely range: ${fci(d.ci)} points`;
      $('sig-diff').textContent = d.significant ? 'This gap is big enough to be real.' : 'Too close to call: the gap could easily be zero.';
      const t = w.A + w.B + w.C;
      const part = (x: number) => `${Math.round((x / t) * 100)}%`;
      $('formula').textContent = t ? `The score is ${part(w.A)} true statements, ${part(w.B)} promises kept and ${part(w.C)} world rankings.` : 'All sliders are at zero, so there is nothing to score.';
    }
    ['wA', 'wB', 'wC', 'excl'].forEach((i) => $(i).addEventListener('input', update));
    update();
  </script>
</Base>

<style>
  .lede { max-width: none; }
  /* Three equal scorecards with one gap span the full column at every width. */
  .vs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin: 0 0 8px; }
  .vs-card { display: flex; flex-direction: column; gap: 14px; }
  .vs-h { display: flex; align-items: center; gap: 8px; }
  .vs-h h2, .vs-h h3 { margin: 0; font-size: 15px; font-weight: 600; }
  .pdot { width: 10px; height: 10px; border-radius: 50%; background: var(--muted); flex: none; }
  [data-party='BJP'] .pdot, [data-party='BJP'].vs-h .pdot { background: var(--p-bjp); }
  [data-party='INC'] .pdot, [data-party='INC'].vs-h .pdot { background: var(--p-inc); }
  .vs-body { display: flex; gap: 18px; align-items: center; }
  .vs-side { display: flex; flex-direction: column; gap: 10px; min-width: 0; flex: 1; }
  .vs-side .vlist li { white-space: nowrap; }
  .vlist { flex-direction: column; gap: 5px; }
  .vlist li { display: grid; grid-template-columns: 10px 1fr auto; gap: 8px; }
  .vlist b { text-align: right; }
  .nowrap { white-space: nowrap; }
  .gapfig { font-size: var(--fs-kpi); font-weight: 700; letter-spacing: -.03em; line-height: 1; }
  .gapread { margin: 0; font-size: 14px; }
  .slhint { margin: 0 0 4px; }
  .diff .sliders label { grid-template-columns: max-content minmax(0, 1fr) 28px; }
  .diff .sliders input[type=range] { min-width: 0; width: 100%; }
  .diff .sliders { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--rule); }
  .mixgrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .mixcard { display: flex; flex-direction: column; gap: 14px; padding: 18px; }
  .foot { margin-top: auto; font-size: 13px; font-weight: 500; }
  .mixbody { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .mixbody .vlist { width: 100%; }
  .spread { display: flex; flex-direction: column; gap: 4px; }
  .sp-legend { margin-bottom: 10px; }
  .sp-legend li { display: inline-flex; align-items: center; gap: 6px; }
  .sp-mid { margin-left: auto; }
  .sp-row { display: grid; grid-template-columns: minmax(150px, 240px) 1fr; gap: 20px; align-items: center; padding: 10px 0; border-top: 1px solid var(--rule); }
  .sp-name { font-size: 14px; font-weight: 500; }
  .sp-bars { display: flex; flex-direction: column; gap: 6px; }
  .sp-bar { display: grid; grid-template-columns: 1fr 120px; gap: 12px; align-items: center; }
  .sp-track { position: relative; height: 14px; background: var(--raised); border-radius: 3px; overflow: hidden; }
  .sp-track::after { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--text); opacity: .45; z-index: 1; }
  .sp-track i { position: absolute; inset: 0 auto 0 0; border-radius: 3px; transition: opacity .15s; }
  .sp-bar[data-party='BJP'] i { background: var(--p-bjp); }
  .sp-bar[data-party='INC'] i { background: var(--p-inc); }
  .sp-bar:hover i { opacity: .8; }
  .sp-val { font-size: 14px; font-weight: 600; white-space: nowrap; }
  .sp-val .kv { font-weight: 400; }
  @media (max-width: 640px) { .sp-row { grid-template-columns: 1fr; gap: 8px; } .sp-bar { grid-template-columns: 1fr 96px; } .sp-mid { margin-left: 0; } }
  .heat2 td.c { text-align: center; min-width: 4.5rem; }
  .heat2 td.c b { display: block; font-weight: 600; }
  .heat2 td.c span { font-size: 12px; color: var(--text); }
  .heat2 td.na { color: var(--muted); font-size: 12px; text-align: center; }
  tr.k-party th, tr.k-party td { border-top: 1px solid var(--border); background: var(--ground); }
  .rates .big2 { font-size: 20px; font-weight: 700; letter-spacing: -.01em; }
  .rates .big2.na { color: var(--muted); }
  .rates td .kv, .rates td.num { white-space: nowrap; }
  @media (max-width: 1180px) { .vs-body { flex-direction: column; align-items: stretch; } .vs-body .donut { align-self: center; } .nowrap { white-space: normal; } }
  @media (max-width: 1000px) { .vs { grid-template-columns: repeat(2, minmax(0, 1fr)); } .vs .diff { grid-column: 1 / -1; } .mixgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vs-body { flex-direction: column; align-items: stretch; } .vs-body .donut { align-self: center; } .nowrap { white-space: normal; } }
  @media (max-width: 640px) { .vs, .mixgrid { grid-template-columns: 1fr; } .vs-body { flex-direction: column; align-items: stretch; } .vs-body .donut { align-self: center; } }
</style>
