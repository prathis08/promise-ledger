---
import { u } from '../lib/site';
import Base from '../layouts/Base.astro';
import Cell from '../components/Cell.astro';
import { getData } from '../lib/data';
import { getBench, f3, fci, fd } from '../lib/bench';
import { DEFAULT_WEIGHTS, MIN_N, BOOTSTRAP_N, PARTIES, RATES } from '../lib/scoring';
const b = getBench();
const { claims } = getData();
const drafts = claims.filter((c) => c.review_status === 'draft').length;
const verified = claims.filter((c) => c.review_status === 'verified').length;
const count = (p: string) => claims.filter((c) => c.party === p && c.scored !== false).length;
const partyRows = b.rows.filter((r) => r.kind === 'party');
const bg = (s: number | null) => s == null ? '' : s >= 0.5 ? `background:color-mix(in srgb, var(--v-true) ${Math.round((s - 0.5) * 120)}%, var(--card))` : `background:color-mix(in srgb, var(--v-false) ${Math.round((0.5 - s) * 120)}%, var(--card))`;
const radar = { labels: b.domains.map((d) => d.name), sets: PARTIES.map((p) => ({ label: p.name, data: b.domains.map((d) => (d.byParty[p.id].AB.sufficient ? d.byParty[p.id].AB.mean : null)) })) };
const clientData = { parties: b.parties.map((p) => ({ id: p.id, A: p.pools.A, B: p.pools.B, C: p.cPool })), defaults: DEFAULT_WEIGHTS };
const pct = (x: number | null | undefined) => (x == null ? '—' : `${(x * 100).toFixed(1)}%`);
const pci = (c: [number, number] | null) => (c ? `[${(c[0] * 100).toFixed(0)}–${(c[1] * 100).toFixed(0)}%]` : '');
const pp = (d: { diff: number | null; ci: [number, number] | null }) => d.diff == null ? '—' : `${d.diff >= 0 ? '+' : '−'}${Math.abs(d.diff * 100).toFixed(1)} pp ${d.ci ? `[${(d.ci[0] * 100).toFixed(0)}, ${(d.ci[1] * 100).toFixed(0)}]` : ''}`;
const who = (d: { diff: number | null; significant: boolean }) => d.diff == null ? '—' : !d.significant ? 'no clear difference' : d.diff > 0 ? `${PARTIES[0].name} higher` : `${PARTIES[1].name} higher`;
const VLABEL: Record<string, string> = { true: 'true / met', 'in-progress': 'in progress', 'missed-deadline': 'missed deadline', misleading: 'misleading', unachieved: 'unachieved', false: 'false', unverifiable: 'unverifiable', 'not-yet-due': 'not yet due' };
const w = (k: 'A' | 'B' | 'C') => Math.round(DEFAULT_WEIGHTS[k] * 100);
const dtxt = (d: { diff: number | null; ci: [number, number] | null; significant: boolean }) => d.diff == null ? '—' : `${fd(d.diff)} ${fci(d.ci)}${d.significant ? '' : ' · not significant'}`;
---
<Base title="Leaderboard">
  <h1>Promise Ledger: BJP vs Congress</h1>
  <p class="muted">Two parties evaluated like two models on the same benchmark. Each claim or promise by a party's Union ministers, Chief Ministers or leaders is a test case; global indices measure the change during each party's era at the centre. Rules: <a href={u('/methodology/')}>methodology</a>.</p>
  <div class="banner draft" role="alert">Preliminary: {verified} of {claims.length} entries are human-verified; {drafts} are unreviewed drafts. Sample sizes are small; read the confidence intervals. <a href={u('/review/')}>Help review claims</a>.</div>

  <section class="vs" aria-label="Head to head">
    {partyRows.map((r) => (
      <div class="vs-card" data-party={r.party}>
        <div class="sans small muted">{r.label}</div>
        <div class="big" id={`ov-${r.party}`}>{f3(r.overall?.score)}</div>
        <div class="ci" id={`ci-${r.party}`}>95% CI {fci(r.overall?.ci ?? null)} · n={r.overall?.n}</div>
        <div class="kv">{count(r.party)} scored claims</div>
      </div>
    ))}
    <div class="vs-card diff">
      <div class="sans small muted">Difference (BJP − INC), overall</div>
      <div class="big" id="ov-diff">{b.h2h.overall.diff == null ? '—' : fd(b.h2h.overall.diff)}</div>
      <div class="ci" id="ci-diff">95% CI {fci(b.h2h.overall.ci)}</div>
      <div class="kv" id="sig-diff">{b.h2h.overall.significant ? 'CI excludes 0' : 'CI includes 0: no clear difference'}</div>
    </div>
  </section>

  <h2>False claim rate</h2>
  <p class="muted">Rates are shares of each party's own graded claims, so a party with fewer claims is not penalised. Lower is better for every row.</p>
  <div class="tablewrap"><table class="dense rates">
    <thead><tr><th>Rate</th>{PARTIES.map((p) => <th class="r">{p.name}</th>)}<th class="r">{PARTIES[0].name} − {PARTIES[1].name} (95% CI)</th><th>Reading</th></tr></thead>
    <tbody>{RATES.map((r) => (
      <tr><th scope="row">{r.label}<div class="kv">{r.help}</div></th>
        {PARTIES.map((p) => { const st = b.rates[p.id][r.id]; return (
          <td class="r"><span class={`big2 ${st.sufficient ? '' : 'na'}`}>{pct(st.mean)}</span><div class="kv">{st.n ? `${Math.round((st.mean ?? 0) * st.n)} of ${st.n}` : 'n=0'} {st.sufficient ? pci(st.ci) : `· n < ${MIN_N}`}</div></td>); })}
        <td class="r num">{pp(b.rateDiffs[r.id])}</td>
        <td>{who(b.rateDiffs[r.id])}</td></tr>
    ))}</tbody>
  </table></div>
  <p class="kv">pp = percentage points. "Higher" is stated only when the 95% bootstrap interval of the difference excludes 0. Promises not yet due and unverifiable claims are not counted in any rate.</p>

  <h3>Verdict mix</h3>
  {PARTIES.map((p) => (
    <div class="mix">
      <div class="mix-h"><b>{p.label}</b></div>
      {(['A', 'B'] as const).map((k) => { const m = b.mix[p.id][k]; const tot = m.reduce((a, x) => a + x.n, 0); return (
        <div class="mix-row"><span class="kv">{k === 'A' ? 'Statements & statistics' : 'Promises'} · {tot}</span>
          <div class="stack" role="img" aria-label={`${p.name} ${k === 'A' ? 'statements' : 'promises'}: ${m.map((x) => `${VLABEL[x.verdict]} ${x.n}`).join(', ')}`}>
            {m.map((x) => <i style={`width:${(x.share * 100).toFixed(2)}%;background:var(--v-${x.verdict})`} title={`${VLABEL[x.verdict]}: ${x.n} (${(x.share * 100).toFixed(0)}%)`}></i>)}
          </div>
          <div class="legend">{m.map((x) => <span><i style={`background:var(--v-${x.verdict})`}></i>{VLABEL[x.verdict]} {x.n} ({(x.share * 100).toFixed(0)}%)</span>)}</div>
        </div>); })}
    </div>
  ))}

  <form class="sliders" id="weights" onsubmit="return false">
    <label>Suite A weight<input type="range" min="0" max="100" step="5" value={w('A')} id="wA" /><output class="num" id="oA"></output></label>
    <label>Suite B weight<input type="range" min="0" max="100" step="5" value={w('B')} id="wB" /><output class="num" id="oB"></output></label>
    <label>Suite C weight<input type="range" min="0" max="100" step="5" value={w('C')} id="wC" /><output class="num" id="oC"></output></label>
    <label class="toggle" style="grid-template-columns:auto"><span><input type="checkbox" id="excl" /> Exclude flagged indices from suite C</span></label>
    <div class="kv" id="formula">Weights are normalised to sum to 1. CI: {BOOTSTRAP_N} bootstrap resamples, fixed seed.</div>
  </form>

  <h2>Head to head by suite</h2>
  <div class="tablewrap"><table class="dense">
    <thead><tr><th>Suite</th>{partyRows.map((r) => <th>{r.label}</th>)}<th>BJP − INC (95% CI)</th></tr></thead>
    <tbody>
      <tr><th scope="row"><a href={u('/suites/accuracy/')}>A: Factual Accuracy</a></th>{partyRows.map((r) => <td><Cell st={r.A} extra={`strict ${f3(r.A.share)} · abstained ${r.A.abstained}`} /></td>)}<td class="num">{dtxt(b.h2h.A)}</td></tr>
      <tr><th scope="row"><a href={u('/suites/promises/')}>B: Promise Delivery</a></th>{partyRows.map((r) => <td><Cell st={r.B} extra={`on-time ${f3(r.B.share)} · abstained ${r.B.abstained} · not yet due ${r.B.pending}`} /></td>)}<td class="num">{dtxt(b.h2h.B)}</td></tr>
      <tr><th scope="row"><a href={u('/benchmarks/')}>C: Index change in era</a></th>{partyRows.map((r) => <td>{r.C && <Cell st={r.C} extra={`up ${r.C.improved} / down ${r.C.declined} · mean Δ/yr ${r.C.meanPerYear == null ? '—' : fd(r.C.meanPerYear)}`} />}</td>)}<td class="num">{dtxt(b.h2h.C)}</td></tr>
    </tbody>
  </table></div>
  <p class="kv">Scores 0–1, higher is better. Suite C = share of indices that improved during the party's era (INC: 2004 → 2014 edition; BJP: 2014 → latest). Cells with n &lt; {MIN_N} show no score. A difference is "significant" here only when its 95% CI excludes 0.</p>

  <h2>Leaderboard</h2>
  <div class="tablewrap"><table class="dense">
    <thead><tr><th>Model</th><th>Party</th><th>A: Factual Accuracy</th><th>B: Promise Delivery</th></tr></thead>
    <tbody>
      {b.rows.map((r) => (
        <tr class={`k-${r.kind}`}>
          <th scope="row">{r.kind === 'party' ? <b>{r.label}</b> : r.kind === 'level' ? <span>↳ {r.label}</span> : <span class="muted">· {r.label}</span>}</th>
          <td>{r.party}</td>
          <td><Cell st={r.A} /></td>
          <td><Cell st={r.B} /></td>
        </tr>
      ))}
    </tbody>
  </table></div>
  <p class="kv">Rows: each party, then by office (Union ministers, Chief Ministers, party office-bearers), then individual speakers with at least 3 graded claims.</p>

  <h2>Domain × suite</h2>
  <div class="tablewrap"><table class="dense heat2">
    <thead><tr><th rowspan="2">Domain</th>{PARTIES.map((p) => <th colspan="3">{p.name}</th>)}</tr><tr>{PARTIES.map(() => <><th>A</th><th>B</th><th>C</th></>)}</tr></thead>
    <tbody>{b.domains.map((d) => (
      <tr><th scope="row">{d.name}</th>{PARTIES.map((p) => [d.byParty[p.id].A, d.byParty[p.id].B, d.byParty[p.id].C].map((st) => st.sufficient
        ? <td class="c" style={bg(st.mean)}><b>{f3(st.mean)}</b><span>n={st.n}</span></td>
        : <td class="c na">n={st.n}</td>))}</tr>
    ))}</tbody>
  </table></div>
  <p class="kv">Claims are assigned to the domain of their first topic. Shade: scale from 0 to 1 around 0.5; the value is always printed. Greyed: n &lt; {MIN_N}.</p>

  <h2>Radar by domain (A and B combined)</h2>
  <div class="radarbox"><canvas id="radar" role="img" aria-label="Radar chart of combined claim scores by domain for each party"></canvas></div>
  <p class="kv">Each point is the mean of all graded claims (suites A and B) in that domain. Domains with n &lt; {MIN_N} for a party are left out of its polygon.</p>

  <script type="application/json" id="bench-data" set:html={JSON.stringify(clientData)} />
  <script type="application/json" id="radar-data" set:html={JSON.stringify(radar)} />
  <script>
    import { overall, diffOverall } from '../lib/scoring';
    import { Chart, RadarController, RadialLinearScale, PointElement, LineElement, Filler, Legend, Tooltip } from 'chart.js';
    const $ = (id: string) => document.getElementById(id)!;
    const D = JSON.parse($('bench-data').textContent!);
    const f3 = (x: number | null) => (x == null ? '—' : x.toFixed(3));
    const fci = (c: number[] | null) => (c ? `[${c[0].toFixed(2)}, ${c[1].toFixed(2)}]` : '');
    const sg = (x: number) => (x >= 0 ? '+' : '−') + Math.abs(x).toFixed(3);
    function update() {
      const w = { A: +($('wA') as HTMLInputElement).value, B: +($('wB') as HTMLInputElement).value, C: +($('wC') as HTMLInputElement).value };
      const excl = ($('excl') as HTMLInputElement).checked;
      for (const k of ['A', 'B', 'C']) $('o' + k).textContent = String(w[k as 'A']);
      const pools = D.parties.map((p: any) => ({ A: p.A, B: p.B, C: p.C.filter((c: any) => !(excl && c.x)).map((c: any) => c.s) }));
      D.parties.forEach((p: any, i: number) => {
        const o = overall(pools[i], w);
        $('ov-' + p.id).textContent = f3(o.score);
        $('ci-' + p.id).textContent = `95% CI ${fci(o.ci)} · n=${o.n}`;
      });
      const d = diffOverall(pools[0], pools[1], w);
      $('ov-diff').textContent = d.diff == null ? '—' : sg(d.diff);
      $('ci-diff').textContent = `95% CI ${fci(d.ci)}`;
      $('sig-diff').textContent = d.significant ? 'CI excludes 0' : 'CI includes 0: no clear difference';
      const t = w.A + w.B + w.C;
      $('formula').textContent = t ? `Overall = ${(w.A / t).toFixed(2)}·A + ${(w.B / t).toFixed(2)}·B + ${(w.C / t).toFixed(2)}·C for each party (suites with no data are dropped and weights renormalised).` : 'All weights are zero.';
    }
    ['wA', 'wB', 'wC', 'excl'].forEach((i) => $(i).addEventListener('input', update));
    update();

    Chart.register(RadarController, RadialLinearScale, PointElement, LineElement, Filler, Legend, Tooltip);
    const css = getComputedStyle(document.documentElement), v = (n: string) => css.getPropertyValue(n).trim();
    Chart.defaults.color = v('--muted'); Chart.defaults.borderColor = v('--line'); Chart.defaults.font.family = v('--sans');
    const R = JSON.parse($('radar-data').textContent!);
    const colors = [v('--p-bjp') || '#e07b00', v('--p-inc') || '#1f6fd1'];
    new Chart($('radar') as HTMLCanvasElement, {
      type: 'radar',
      data: { labels: R.labels, datasets: R.sets.map((s: any, i: number) => ({ label: s.label, data: s.data, borderColor: colors[i], backgroundColor: colors[i] + '22', pointBackgroundColor: colors[i], spanGaps: false, borderWidth: 2 })) },
      options: { responsive: true, maintainAspectRatio: false, scales: { r: { min: 0, max: 1, ticks: { backdropColor: 'transparent' } } } },
    });
  </script>
</Base>

<style>
  .vs { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; margin: 1.25rem 0; }
  .vs-card { border: 1px solid var(--line); border-radius: 8px; padding: 1rem; background: var(--card); }
  .vs-card[data-party='BJP'] { border-top: 4px solid var(--p-bjp, #e07b00); }
  .vs-card[data-party='INC'] { border-top: 4px solid var(--p-inc, #1f6fd1); }
  .vs-card.diff { border-top: 4px solid var(--line); }
  .heat2 td.c { text-align: center; min-width: 4.5rem; }
  .heat2 td.c b { display: block; font-family: var(--mono, monospace); }
  .heat2 td.c span { font-size: 0.75rem; color: var(--muted); }
  .heat2 td.na { color: var(--muted); font-size: 0.75rem; }
  tr.k-party th, tr.k-party td { border-top: 2px solid var(--line); }
  .rates .big2 { font-family: var(--mono, monospace); font-size: 1.35rem; font-weight: 600; }
  .rates .big2.na { color: var(--muted); }
  .mix { margin: 0.75rem 0 1.25rem; }
  .mix-row { margin: 0.4rem 0; }
  .stack { display: flex; height: 18px; border-radius: 4px; overflow: hidden; border: 1px solid var(--line); background: var(--card); }
  .stack i { display: block; height: 100%; }
  .stack i + i { border-left: 1px solid var(--card); }
  .legend { display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; font-size: 0.78rem; color: var(--muted); margin-top: 0.25rem; }
  .legend i { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 2px; margin-right: 0.3rem; vertical-align: -1px; }
</style>
